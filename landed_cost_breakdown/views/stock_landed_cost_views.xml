<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_landed_cost_form_component" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.cost.component</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cancel_landed_cost" type="object"
                        string="Cancel" class="btn-secondary"
                        invisible="state != 'done'"
                        groups="stock.group_stock_manager"
                        confirm="This cancels this landed cost and its journal entry, and removes it from the stock valuation and product cost. No reversing entry is created. Continue?"/>
            </xpath>

            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                        invisible="state != 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='cost_lines']/list/field[@name='split_method']" position="after">
                <field name="cost_component"/>
            </xpath>
            <xpath expr="//field[@name='cost_lines']/form//field[@name='split_method']" position="after">
                <field name="cost_component"/>
            </xpath>
        </field>
    </record>
</odoo>

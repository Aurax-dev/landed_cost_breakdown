<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profitability_tier_list" model="ir.ui.view">
        <field name="name">product.profitability.tier.list</field>
        <field name="model">product.profitability.tier</field>
        <field name="arch" type="xml">
            <list string="Profitability Tiers" editable="bottom">
                <field name="min_margin"/>
                <field name="name"/>
                <field name="decoration"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_profitability_tier" model="ir.actions.act_window">
        <field name="name">Profitability Tiers</field>
        <field name="res_model">product.profitability.tier</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your profitability tiers</p>
            <p>Set the margin % thresholds and colors used by the cost breakdown
               (e.g. ≥ 50% = Profitable, &lt; 0% = Loss). A tier applies when the
               margin % is at or above its threshold.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_cost_sheet_form" model="ir.ui.view">
        <field name="name">product.cost.sheet.form</field>
        <field name="model">product.cost.sheet</field>
        <field name="arch" type="xml">
            <form string="Cost Sheet">
                <header>
                    <button name="action_print_report" type="object"
                            string="Print PDF" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="cost_method" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="current_standard_price" widget="monetary" readonly="1"/>
                            <field name="variance" widget="monetary" readonly="1"
                                   decoration-warning="variance != 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Breakdown" name="breakdown">
                            <field name="line_ids">
                                <list create="false" delete="false" editable="bottom"
                                      decoration-muted="hidden">
                                    <field name="hidden" string="Hide" widget="boolean_toggle"/>
                                    <field name="component" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="source_ref" widget="reference" readonly="1"/>
                                    <field name="included_in_cost" optional="show" readonly="1"/>
                                    <field name="amount" sum="Total Cost / Unit" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_cost" widget="monetary" readonly="1"/>
                            </group>
                        </page>
                        <page string="Cost History" name="history">
                            <group>
                                <group>
                                    <field name="history_period"/>
                                    <field name="history_date_from"
                                           invisible="history_period != 'custom'"
                                           required="history_period == 'custom'"/>
                                    <field name="history_date_to"
                                           invisible="history_period != 'custom'"
                                           required="history_period == 'custom'"/>
                                </group>
                                <group>
                                    <button name="action_refresh_history" type="object"
                                            string="Apply" class="btn-primary"/>
                                </group>
                            </group>
                            <field name="history_line_ids">
                                <list create="false" delete="false" edit="false" default_order="date">
                                    <field name="date"/>
                                    <field name="document" string="Purchase Order"/>
                                    <field name="quantity" string="Qty" optional="show"/>
                                    <field name="base_cost" widget="monetary" string="Base Cost"/>
                                    <field name="landed_cost" widget="monetary" string="Landed Cost"/>
                                    <field name="batch_cost" widget="monetary" string="Batch Cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <separator string="How the current cost is calculated (units in stock)"/>
                            <field name="layer_ids">
                                <list create="false" delete="false" edit="false" default_order="date">
                                    <field name="date" string="Received"/>
                                    <field name="document" string="Purchase Order"/>
                                    <field name="quantity" string="Qty on Hand" sum="Total Qty"/>
                                    <field name="unit_cost" widget="monetary" string="Unit Cost"/>
                                    <field name="value" widget="monetary" string="Value" sum="Total Value"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="current_standard_price" string="Current Cost / Unit"
                                       widget="monetary" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_cost_sheet_list" model="ir.ui.view">
        <field name="name">product.cost.sheet.list</field>
        <field name="model">product.cost.sheet</field>
        <field name="arch" type="xml">
            <list string="Cost Sheets" decoration-muted="state == 'released'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="cost_method"/>
                <field name="date"/>
                <field name="total_cost" widget="monetary"/>
                <field name="current_standard_price" widget="monetary" optional="show"/>
                <field name="released_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'released'"
                       decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_cost_sheet_search" model="ir.ui.view">
        <field name="name">product.cost.sheet.search</field>
        <field name="model">product.cost.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="released" string="Released" domain="[('state', '=', 'released')]"/>
                <separator/>
                <filter name="group_product" string="Product"
                        context="{'group_by': 'product_tmpl_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_cost_sheet" model="ir.actions.act_window">
        <field name="name">Cost Sheets</field>
        <field name="res_model">product.cost.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build a product cost breakdown</p>
            <p>Create a versioned, printable breakdown of how a product's cost is composed.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_costing" model="ir.ui.view">
        <field name="name">res.config.settings.form.product.costing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Product Costing" name="landed_cost_breakdown_block">
                    <setting string="Lock Product Cost"
                             help="Make the product Cost field read-only on product forms.">
                        <field name="product_cost_locked"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
